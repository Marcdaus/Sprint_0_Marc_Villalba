<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ============ PERMISOS BLUETOOTH ============
         Hasta Android 11 (API 30) valen BLUETOOTH + BLUETOOTH_ADMIN (se dan al instalar).
         Desde Android 12 (API 31) se pide ademas BLUETOOTH_SCAN y BLUETOOTH_CONNECT,
         y ADEMAS hay que pedirlos en ejecucion con requestPermissions(). -->

    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- BLUETOOTH_SCAN: sin este, startScan()/stopScan() no devuelven nada en Android 12+ -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <!-- BLUETOOTH_CONNECT: sin este, getName()/getAddress()/isEnabled() no funcionan en Android 12+ -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- La ubicacion es obligatoria para escanear BLE en Android 6 a 11 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Para el POST al servidor REST -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- La app usa BLE, pero no impide instalarla en dispositivos sin él -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.BTLMARC">

        <!-- Pantalla unica: los tres Activity de los esqueletos, unidos en esta -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- El servicio que escucha los beacons (PROMPT 2) -->
        <service
            android:name=".ServicioEscuharBeacons"
            android:exported="false" />

    </application>

</manifest>
